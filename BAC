end
local attackTab = Window:CreateTab({name="ATTACK",icon="crosshair"});
attackTab:CreateButton({name="Place dot / Move dot",callback=onPlaceDot});
attackTab:CreateButton({name="Start spam / Stop spam",callback=onToggleSpam});
attackTab:CreateButton({name="Lock / Unlock dot",callback=onToggleLock});
attackTab:CreateSlider({name="Spam speed",range={1,50},increment=1,value=attack.cps,suffix=" clicks/s",callback=function(v)
